# ============================================================
# MenuSheet environment configuration
# Copy to .env.local for local dev / set in your CI for builds.
#
# Admin credentials and SHARED_SECRET are NOT here. They are encrypted
# secrets on the auth Worker (see admin-auth-worker/wrangler.toml):
#   wrangler secret put ADMIN_EMAIL
#   wrangler secret put ADMIN_PASSWORD
#   wrangler secret put SESSION_SECRET
#   wrangler secret put SHARED_SECRET
#
# Only NEXT_PUBLIC_* values are inlined into the client bundle.
# ============================================================

# --- Public site -----------------------------------------------------------
# Canonical origin used for SEO tags, sitemap, QR codes, share links.
NEXT_PUBLIC_SITE_URL=https://menusheetapp.pages.dev

# How long a visitor's browser may reuse a fetched menu without refetching
# (hours). "ok" menus use this TTL; inactive/expired states cache much
# shorter so kill-switches propagate quickly. Default: 6
NEXT_PUBLIC_MENU_CACHE_TTL_HOURS=6

# --- Admin Dashboard: auth Worker ------------------------------------------
# Public URL of the auth Worker. It verifies sign-in, issues the HttpOnly
# session cookie, and proxies every privileged Apps Script call so that
# SHARED_SECRET is never exposed to the browser.
NEXT_PUBLIC_ADMIN_AUTH_WORKER_URL=https://menusheet-admin-auth.<your-subdomain>.workers.dev

# --- Apps Script endpoints + shared secret ---------------------------------
# PRIVATE (server-side only): used by scripts/generate-static-data.js at
# build time. Do NOT prefix these with NEXT_PUBLIC_.
ADMIN_APPS_SCRIPT_URL=
SHARED_SECRET=
