# ============================================================
# MenuSheet environment configuration
# Copy to .env.local for local dev / set in your CI for builds.
#
# Admin credentials and SHARED_SECRET are NOT here. They are encrypted
# secrets on the platform Worker (see worker/wrangler.toml):
#   cd worker
#   wrangler secret put ADMIN_EMAIL
#   wrangler secret put ADMIN_PASSWORD
#   wrangler secret put SESSION_SECRET
#   wrangler secret put SHARED_SECRET
#
# Only NEXT_PUBLIC_* values are inlined into the client bundle.
# ============================================================

# --- Public site -----------------------------------------------------------
# Canonical origin used for SEO tags, sitemap, QR codes, share links.
NEXT_PUBLIC_SITE_URL=https://menusheetapp.pages.dev

# How long a visitor's browser may reuse a fetched menu without asking the
# platform again (minutes). This is a *browser-side* cache only — the
# authoritative per-restaurant cache lifetime is the `cache_ttl_seconds`
# field on each restaurant, editable from the admin dashboard.
# Default: 5
NEXT_PUBLIC_MENU_CACHE_TTL_MINUTES=5

# --- Platform Worker -------------------------------------------------------
# The single API for this whole app: public menu reads, admin CRUD, sign-in,
# and the manual reload that fetches a restaurant's Google Sheet. The browser
# only ever sees this URL plus its session cookie.
NEXT_PUBLIC_API_URL=https://menusheet-api.<your-subdomain>.workers.dev

# Nothing else is needed. In particular there is no API token, and the KV seed
# authenticates through `wrangler login` instead of a shared secret:
#   cd worker && npm install && node scripts/seed-kv.mjs --write
