# ============================================================
# MenuSheet environment configuration
# Copy to .env.local for local dev / set in your CI for builds.
# All NEXT_PUBLIC_* values are inlined into the client bundle.
# ============================================================

# --- Public site -----------------------------------------------------------
# Canonical origin used for SEO tags, sitemap, QR codes, share links.
NEXT_PUBLIC_SITE_URL=https://menusheetapp.pages.dev

# How long a visitor's browser may reuse a fetched menu without refetching
# (hours). "ok" menus use this TTL; inactive/expired states cache much
# shorter so kill-switches propagate quickly. Default: 6
NEXT_PUBLIC_MENU_CACHE_TTL_HOURS=6

# --- Admin Dashboard: Supabase Authentication ------------------------------
# These identify your Supabase project and are safe to expose publicly.
# Real access control = Supabase Auth + the email allow-list below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated allow-list of admin emails. Anyone signed in with an
# email not on this list is immediately signed out of the dashboard.
NEXT_PUBLIC_ADMIN_ALLOWED_EMAILS=owner@gmail.com

# --- Apps Script endpoints + shared secret ---------------------------------
# PUBLIC (inlined into the Admin Dashboard bundle): used by the dashboard
# to call addRestaurant / updateRestaurant on the Admin Apps Script.
# This is an accepted trade-off of the no-backend architecture — see
# docs/onboarding-checklist.md ("SHARED_SECRET rotation runbook").
NEXT_PUBLIC_ADMIN_APPS_SCRIPT_URL=
NEXT_PUBLIC_SHARED_SECRET=

# PRIVATE (server-side only): used by scripts/generate-static-data.js at
# build time. Do NOT prefix these with NEXT_PUBLIC_.
ADMIN_APPS_SCRIPT_URL=
SHARED_SECRET=
